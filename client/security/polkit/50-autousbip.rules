/* Polkit rules for Auto USB/IP Client
 * Authorizes members of wheel/sudo/plugdev and active desktop sessions to manage USB/IP without password prompts.
 * Handles both direct custom actions and pkexec program execution (works on immutable distros like Fedora Silverblue/Atomic).
 */
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec") {
        var prog = action.lookup("program");
        if (prog === "/usr/bin/usbip" || prog === "/usr/sbin/usbip" || (prog && prog.indexOf("usbip") !== -1)) {
            if (subject.isInGroup("wheel") || subject.isInGroup("sudo") || subject.isInGroup("plugdev") || subject.active || subject.local) {
                return polkit.Result.YES;
            }
        }
    }
    if (action.id === "org.autousbip.client.usbip" || action.id === "org.autousbip.client.tuning") {
        if (subject.isInGroup("wheel") || subject.isInGroup("sudo") || subject.isInGroup("plugdev") || subject.active || subject.local) {
            return polkit.Result.YES;
        }
    }
});
